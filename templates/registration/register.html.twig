{% extends 'base.html.twig' %}

{% block title %}Créer un compte{% endblock %}

{% block body %}
<div class="container mt-4" style="max-width: 450px;">
    <div class="card">
        <div class="card-header bg-dark text-white">
            <strong>Créer un compte</strong>
        </div>
        <div class="card-body">
            {% for flash_error in app.flashes('verify_email_error') %}
                <div class="alert alert-danger" role="alert">{{ flash_error }}</div>
            {% endfor %}

            <p class="text-muted">Seule une adresse email valide est nécessaire pour créer votre compte.</p>

            {{ form_errors(registrationForm) }}

            {{ form_start(registrationForm) }}
                <div class="mb-3">
                    {{ form_row(registrationForm.email, { attr: { class: 'form-control' } }) }}
                </div>
                <div class="mb-3">
                    {{ form_row(registrationForm.plainPassword, { attr: { class: 'form-control' } }) }}
                </div>
                <button type="submit" class="btn btn-primary w-100">Créer mon compte</button>
            {{ form_end(registrationForm) }}

            <div class="mt-3 text-center">
                Déjà un compte ? <a href="{{ path('app_login') }}">Se connecter</a>
            </div>
        </div>
    </div>
</div>
{% endblock %}
