{% if pageCount > 1 %}
<nav aria-label="Pagination" class="mt-3">
    <ul class="pagination justify-content-center">

        {# Lien "Précédent" #}
        {% if current > first %}
            <li class="page-item">
                <a class="page-link" href="{{ path(route, query|merge({(pageParameterName): current - 1})) }}">&laquo;</a>
            </li>
        {% else %}
            <li class="page-item disabled">
                <span class="page-link">&laquo;</span>
            </li>
        {% endif %}

        {# Pages #}
        {% for page in pagesInRange %}
            {% if page != current %}
                <li class="page-item">
                    <a class="page-link" href="{{ path(route, query|merge({(pageParameterName): page})) }}">{{ page }}</a>
                </li>
            {% else %}
                <li class="page-item active" aria-current="page">
                    <span class="page-link">{{ page }}</span>
                </li>
            {% endif %}
        {% endfor %}

        {# Lien "Suivant" #}
        {% if current < last %}
            <li class="page-item">
                <a class="page-link" href="{{ path(route, query|merge({(pageParameterName): current + 1})) }}">&raquo;</a>
            </li>
        {% else %}
            <li class="page-item disabled">
                <span class="page-link">&raquo;</span>
            </li>
        {% endif %}

    </ul>
</nav>
{% endif %}
