{% extends 'base.html.twig' %}

{% block title %}Mon profil{% endblock %}

{% block body %}
<div class="container mt-4" style="max-width: 800px;">
    <h1 class="mb-4">Mon profil</h1>

    {# Informations de compte (non modifiables ici) #}
    <div class="card mb-4">
        <div class="card-header bg-dark text-white">
            <strong>Compte</strong>
        </div>
        <div class="card-body">
            <p class="mb-0"><strong>Email :</strong> {{ app.user.email }}</p>
            <p class="mb-0 mt-1">
                <strong>Compte vérifié :</strong>
                {% if app.user.verified %}
                    <span class="badge bg-success">Oui</span>
                {% else %}
                    <span class="badge bg-warning text-dark">Non</span>
                {% endif %}
            </p>
        </div>
    </div>

    {# Formulaire données personnelles #}
    <div class="card mb-4">
        <div class="card-header bg-dark text-white">
            <strong>Données personnelles</strong>
        </div>
        <div class="card-body">
            {{ form_start(profileForm, { action: path('app_profile'), method: 'POST' }) }}
                <div class="row g-3">
                    <div class="col-md-6">
                        {{ form_row(profileForm.firstName, { attr: { class: 'form-control' } }) }}
                    </div>
                    <div class="col-md-6">
                        {{ form_row(profileForm.lastName, { attr: { class: 'form-control' } }) }}
                    </div>
                    <div class="col-12">
                        {{ form_row(profileForm.address, { attr: { class: 'form-control' } }) }}
                    </div>
                    <div class="col-md-6">
                        {{ form_row(profileForm.phone, { attr: { class: 'form-control' } }) }}
                    </div>
                </div>
                <button type="submit" class="btn btn-primary mt-3">Enregistrer</button>
            {{ form_end(profileForm) }}
        </div>
    </div>

    {# Formulaire changement de mot de passe #}
    <div class="card mb-4">
        <div class="card-header bg-dark text-white">
            <strong>Changer le mot de passe</strong>
        </div>
        <div class="card-body">
            <p class="text-muted">Un code de confirmation sera envoyé par email.</p>
            {{ form_start(passwordForm, { action: path('app_profile_change_password'), method: 'POST' }) }}
                <div class="row g-3">
                    <div class="col-md-6">
                        {{ form_row(passwordForm.newPassword.first, { attr: { class: 'form-control' } }) }}
                    </div>
                    <div class="col-md-6">
                        {{ form_row(passwordForm.newPassword.second, { attr: { class: 'form-control' } }) }}
                    </div>
                </div>
                <button type="submit" class="btn btn-warning mt-3">Changer le mot de passe</button>
            {{ form_end(passwordForm) }}
        </div>
    </div>

    {# ===== RÉSERVATIONS À VENIR ===== #}
    <div class="card mb-4">
        <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
            <strong>Réservations à venir</strong>
            <span class="badge bg-primary">{{ reservationsAvenir|length }}</span>
        </div>
        <div class="card-body p-0">
            {% if reservationsAvenir is empty %}
                <p class="text-muted p-3 mb-0">Aucune réservation à venir.</p>
            {% else %}
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Véhicule</th>
                            <th>Du</th>
                            <th>Au</th>
                            <th>Durée</th>
                            <th>Total</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for r in reservationsAvenir %}
                        <tr>
                            <td>{{ r.vehicle.name }}</td>
                            <td>{{ r.startDate|date('d/m/Y') }}</td>
                            <td>{{ r.endDate|date('d/m/Y') }}</td>
                            <td>{{ r.nbJours }} j.</td>
                            <td>{{ r.totalPrice|number_format(0, ',', ' ') }} gal.</td>
                            <td>
                                <a href="{{ path('reservation_bon', {id: r.id}) }}" class="btn btn-sm btn-outline-secondary" title="Voir le bon">
                                    <i class="bi bi-file-earmark-text"></i>
                                </a>
                                <a href="{{ path('app_profile_reservation_edit', {id: r.id}) }}" class="btn btn-sm btn-warning" title="Modifier">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <form method="post" action="{{ path('app_profile_reservation_cancel', {id: r.id}) }}"
                                      style="display:inline"
                                      onsubmit="return confirm('Annuler cette réservation ?')">
                                    <button type="submit" class="btn btn-sm btn-danger" title="Annuler">
                                        <i class="bi bi-x-circle"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            {% endif %}
        </div>
    </div>

    {# ===== RÉSERVATIONS PASSÉES ===== #}
    <div class="card mb-4">
        <div class="card-header bg-secondary text-white d-flex justify-content-between align-items-center">
            <strong>Réservations passées</strong>
            <span class="badge bg-light text-dark">{{ reservationsPassees|length }}</span>
        </div>
        <div class="card-body p-0">
            {% if reservationsPassees is empty %}
                <p class="text-muted p-3 mb-0">Aucune réservation passée.</p>
            {% else %}
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Véhicule</th>
                            <th>Du</th>
                            <th>Au</th>
                            <th>Durée</th>
                            <th>Total</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for r in reservationsPassees %}
                        <tr class="text-muted">
                            <td>{{ r.vehicle.name }}</td>
                            <td>{{ r.startDate|date('d/m/Y') }}</td>
                            <td>{{ r.endDate|date('d/m/Y') }}</td>
                            <td>{{ r.nbJours }} j.</td>
                            <td>{{ r.totalPrice|number_format(0, ',', ' ') }} gal.</td>
                            <td>
                                <a href="{{ path('reservation_bon', {id: r.id}) }}" class="btn btn-sm btn-outline-secondary" title="Voir le bon">
                                    <i class="bi bi-file-earmark-text"></i>
                                </a>
                            </td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            {% endif %}
        </div>
    </div>

</div>
{% endblock %}
