{% extends 'base.html.twig' %}

{% block title %}Modifier la réservation{% endblock %}

{% block body %}
<div class="container mt-4" style="max-width: 600px;">
    <h1 class="mb-4">Modifier la réservation</h1>

    {# Récapitulatif actuel #}
    <div class="card mb-4">
        <div class="card-header bg-secondary text-white">
            <strong>Réservation actuelle</strong>
        </div>
        <div class="card-body">
            <p class="mb-1"><strong>Véhicule :</strong> {{ reservation.vehicle.name }}</p>
            <p class="mb-1"><strong>Du :</strong> {{ reservation.startDate|date('d/m/Y') }}</p>
            <p class="mb-1"><strong>Au :</strong> {{ reservation.endDate|date('d/m/Y') }}</p>
            <p class="mb-0"><strong>Total actuel :</strong> {{ reservation.totalPrice|number_format(0, ',', ' ') }} galions</p>
        </div>
    </div>

    {# Formulaire de modification #}
    <div class="card">
        <div class="card-header bg-dark text-white">
            <strong>Nouvelles informations</strong>
        </div>
        <div class="card-body">
            <form method="post" action="{{ path('app_profile_reservation_edit', {id: reservation.id}) }}">
                <div class="mb-3">
                    <label for="vehicleId" class="form-label">Véhicule</label>
                    <select name="vehicleId" id="vehicleId" class="form-select" required>
                        {% for v in vehicles %}
                            <option value="{{ v.id }}"
                                {% if v.id == reservation.vehicle.id %}selected{% endif %}
                                data-price="{{ v.price }}">
                                {{ v.name }} — {{ v.typeVehicle.name }} — {{ v.price }} gal./j
                            </option>
                        {% endfor %}
                    </select>
                </div>

                <div class="mb-3">
                    <label for="dateStart" class="form-label">Date de début</label>
                    <input type="date" id="dateStart" name="dateStart" class="form-control"
                           value="{{ reservation.startDate|date('Y-m-d') }}" required
                           min="{{ 'now'|date('Y-m-d') }}">
                </div>

                <div class="mb-3">
                    <label for="dateEnd" class="form-label">Date de fin</label>
                    <input type="date" id="dateEnd" name="dateEnd" class="form-control"
                           value="{{ reservation.endDate|date('Y-m-d') }}" required
                           min="{{ 'now'|date('Y-m-d') }}">
                </div>

                {# Aperçu du nouveau prix #}
                <div id="price-preview" class="alert alert-info d-none">
                    Nouveau total estimé : <strong id="total-price"></strong>
                </div>

                <button type="submit" class="btn btn-warning w-100">
                    <i class="bi bi-pencil-square"></i> Enregistrer les modifications
                </button>
            </form>

            <div class="mt-3 text-center">
                <a href="{{ path('app_profile') }}">Annuler</a>
            </div>
        </div>
    </div>
</div>

<script>
    const start = document.getElementById('dateStart');
    const end = document.getElementById('dateEnd');
    const vehicleSelect = document.getElementById('vehicleId');
    const preview = document.getElementById('price-preview');
    const totalEl = document.getElementById('total-price');

    function updatePrice() {
        const selected = vehicleSelect.options[vehicleSelect.selectedIndex];
        const pricePerDay = parseFloat(selected.dataset.price);
        if (start.value && end.value) {
            const days = Math.round((new Date(end.value) - new Date(start.value)) / 86400000);
            if (days > 0) {
                totalEl.textContent = (pricePerDay * days).toLocaleString() + ' galions (' + days + ' jour(s))';
                preview.classList.remove('d-none');
                return;
            }
        }
        preview.classList.add('d-none');
    }

    start.addEventListener('change', updatePrice);
    end.addEventListener('change', updatePrice);
    vehicleSelect.addEventListener('change', updatePrice);
    updatePrice();
</script>
{% endblock %}
